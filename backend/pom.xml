<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml = "Project Object Model". This is MAVEN's config file.
  Maven reads it to know: what is this project, which libraries (dependencies) does it need,
  and how to build it. You never download .jar libraries by hand; you list them here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- PARENT: inherits sensible defaults + compatible versions of hundreds of libraries
         from Spring Boot, so we don't have to specify a version for each dependency. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <!-- Our project's identity: groupId (like a company/package namespace) + artifactId (project name) -->
    <groupId>com.truvira</groupId>
    <artifactId>truvira-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>truvira-backend</name>
    <description>Truvira AI - Truth Verified (backend)</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- spring-boot-starter-web: Spring MVC + embedded Tomcat server. Gives us @RestController etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- spring-boot-starter-data-jpa: Spring Data JPA + Hibernate. Lets us talk to the DB using Java objects. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- spring-boot-starter-validation: annotations like @NotNull for checking input. (used later) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL JDBC driver: the "translator" that lets Java talk to a MySQL server. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2: a tiny in-memory database. We use it ONLY for quick testing without installing MySQL. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- metadata-extractor: reads EXIF / GPS / file-format info hidden inside images.
             Spring Boot's parent does NOT manage this library, so we must give a version ourselves. -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.19.0</version>
        </dependency>

        <!-- spring-boot-starter-security (Slice 7): login + access rules for every request.
             As soon as it's on the classpath, EVERY endpoint is locked until SecurityConfig says otherwise. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JAXB (Jakarta XML Binding), Slice 6: turns annotated Java objects into XML (the report).
             The API = the annotations we write; the runtime = the engine that does the work.
             No <version>: Spring Boot's parent manages both. -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <!-- spring-boot-starter-test: brings JUnit 5 + Mockito + Spring test tools. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lets us run the app with:  mvn spring-boot:run  and package a runnable jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
