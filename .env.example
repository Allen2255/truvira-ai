# .env.example = TEMPLATE for the settings docker-compose.yml needs.
# 1. Copy it:     cp .env.example .env
# 2. Fill in .env with real values. .env is in .gitignore: it must NEVER be committed.

# ---------- REQUIRED SECRETS (choose long random values) ----------
# Password for the MySQL user "truvira_user" (the backend uses it).
DB_PASSWORD=change-me
# Password for MySQL's "root" admin user (only used by the health check / for maintenance).
MYSQL_ROOT_PASSWORD=change-me-too

# ---------- OPTIONAL ----------
# First Truvira login "admin". Leave empty: a random password is printed ONCE in
#   docker compose logs backend
# Change it afterwards in the app (Change password).
TRUVIRA_ADMIN_PASSWORD=

# Local: ":80" (HTTP).  Server: your domain, e.g. truvira.duckdns.org  -> automatic HTTPS
SITE_ADDRESS=:80
# The address people type in the browser. Server example: https://truvira.duckdns.org
PUBLIC_URL=http://localhost
# Ports on THIS machine. Change if 80/443 are already used locally (e.g. 8088 / 8443).
HTTP_PORT=80
HTTPS_PORT=443
# Time zone for evidence timestamps
TZ=Asia/Kolkata
